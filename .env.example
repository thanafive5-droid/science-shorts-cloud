# =============================================================================
# Science Shorts Cloud Factory - Environment Configuration
# Deploy this on Railway, Render, or a Cloud VPS (DO NOT run locally).
# =============================================================================

# --- AI & Media APIs ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Real stock video APIs (Pexels is required; Pixabay is optional fallback)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=

# --- Scheduler & Posting Settings ---
# Timezone for posting schedule (e.g., America/New_York for US English audience, or UTC)
TIMEZONE=America/New_York
POSTS_PER_DAY_PER_CHANNEL=6
DRY_RUN=false

# --- Voiceover Settings (Edge TTS) ---
# Great English voices: en-US-AndrewMultilingualNeural, en-US-BrianNeural, en-US-GuyNeural
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+8%

# --- Storage & Server ---
DATA_DIR=/data
WORK_DIR=/tmp/shorts_jobs
PORT=8080

# --- YouTube OAuth Credentials (Per Channel) ---
# IMPORTANT: YouTube Data API v3 default quota is 10,000 units/day (~6 uploads/day).
# Because each channel posts 6 clips/day, use a separate GCP OAuth Project per channel
# (or request a YouTube API quota increase).
# Generate refresh tokens once using: python scripts/get_youtube_token.py

# 1. Physics Channel
PHYSICS_YT_CLIENT_ID=
PHYSICS_YT_CLIENT_SECRET=
PHYSICS_YT_REFRESH_TOKEN=

# 2. Chemistry Channel
CHEMISTRY_YT_CLIENT_ID=
CHEMISTRY_YT_CLIENT_SECRET=
CHEMISTRY_YT_REFRESH_TOKEN=

# 3. Biology Channel
BIOLOGY_YT_CLIENT_ID=
BIOLOGY_YT_CLIENT_SECRET=
BIOLOGY_YT_REFRESH_TOKEN=

# 4. General Science Channel
GENERAL_SCIENCE_YT_CLIENT_ID=
GENERAL_SCIENCE_YT_CLIENT_SECRET=
GENERAL_SCIENCE_YT_REFRESH_TOKEN=
